# 归一化换行符：仓库内统一以 LF 存储，避免跨平台 diff 噪声
* text=auto

# --- 必须以 LF 存储（CRLF 会破坏 shebang / 解释器执行）---
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.osm       text eol=lf
*.go        text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.hpp       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
CMakeLists.txt text eol=lf

# --- Windows 脚本保留 CRLF ---
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- 二进制文件：禁止任何转换与 diff ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.wasm      binary
*.zip       binary
*.exe       binary
*.dll       binary
